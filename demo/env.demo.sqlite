# Démo AUTODO SANS base de données externe :
#   * base locale en SQLite (aucun MySQL/MariaDB à installer) ;
#   * sources DIAGNET simulées en mémoire, reproductibles (aucune connexion réseau).
# Lancer via :  demo/run_demo_sqlite.ps1            (puis http://127.0.0.1:8501)
DB_BACKEND=sqlite
DIAGNET_SOURCE=fake
DATA_DIR=./data

CONFIG_PASSWORD=cfgpass
DATA_MANAGEMENT_PASSWORD=dmpass
TOKEN_TTL=180
APP_PORT_UNIFIED=8501
APP_TICKETS_URL=http://127.0.0.1:8501/tickets
LOCAL_DB_NAME=tickets_db

# Services simulés optionnels (facultatif : sans eux, notifications et Orange sont simplement journalisés)
SERVER_MAIL=127.0.0.1
SERVER_PORT=1025
SENDER_EMAIL=autodo-demo@example.test
SENDER_NAME="AUTODO Demo"
ORANGE_API_CLIENT_ID=demo-client
ORANGE_API_CLIENT_SECRET=demo-secret-0123456789
ORANGE_API_SERVER_INTRA=http://127.0.0.1:9001
ORANGE_API_SERVER_INTER=http://127.0.0.1:9001
ORANGE_API_TOKEN_ENDPOINT=/oauth/v3/token
ORANGE_API_BASE_ENDPOINT=/troubleticket_sandbox_b2b/v3
CLIENT_USER_ID=DEMOUSER
ORANGE_RELATED_RESOURCE_ID=DEMO-RESOURCE-1
ORANGE_SYNC_INTERVAL_S=10
EMAIL_RECIPIENTS="Demo User,demo@example.test"
WATCHDOG_MAX_AGE_MIN=60
