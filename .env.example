# ============================================================
#  AUTODO — modèle de configuration.   cp .env.example .env
#  Ne JAMAIS versionner un .env renseigné.
# ============================================================

# --- Application
APP_HOST=127.0.0.1               # 0.0.0.0 pour exposer directement ; sinon derrière un reverse proxy TLS
APP_PORT_UNIFIED=8501
APP_TICKETS_URL=                 # URL publique de la page Tickets (lien dans les e-mails)
DATA_DIR=./data                  # config modifiable, journaux : HORS du dépôt
ADMIN_USERNAME=                  # administrateur INITIAL (créé seulement si aucun compte n'existe) ; mot de passe à changer à la 1re connexion
ADMIN_PASSWORD=                  # ≥ 10 caractères, majuscule + minuscule + chiffre
SESSION_IDLE_MINUTES=120         # déconnexion après inactivité
SESSION_MAX_HOURS=12             # durée maximale absolue d'une session
AUTH_MAX_FAILURES=10             # échecs de connexion par IP avant blocage (15 min) ; en plus du verrouillage par compte (5 échecs)
COOKIE_SECURE=false              # true derrière HTTPS
CORS_ORIGINS=                    # vide = même origine uniquement
TRUSTED_PROXIES=                 # IP des reverse proxys de confiance (X-Forwarded-For) ; vide = ignoré
RETENTION_DAYS=90                # purge des visites et journaux
WATCHDOG_MAX_AGE_MIN=15          # alerte interne si aucun cycle réussi depuis N minutes
LOG_LEVEL=INFO

# --- Bases DIAGNET (LECTURE SEULE — un compte en SELECT suffit ; la session est de toute façon READ ONLY)
DB_USER=
DB_PASS=
DB_PORT=3306
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_STATEMENT_TIMEOUT_S=25
COLLECT_MAX_WORKERS=8            # lectures parallèles (≈ nombre de bases / 2)
COLLECT_DB_TIMEOUT_S=60
MODE7D_CACHE_TTL_S=1800          # le mode sur 7 jours est recalculé au plus toutes les 30 min

# --- Base locale (tickets, visites, journaux) : lecture + écriture
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=
LOCAL_DB_PASS=
LOCAL_DB_NAME=tickets_db
LOCAL_DB_POOL_SIZE=8
LOCAL_DB_POOL_OVERFLOW=8

# --- API Orange (CALYPSO)
ORANGE_API_SERVER_INTRA=
ORANGE_API_TOKEN_ENDPOINT=
ORANGE_API_BASE_ENDPOINT=
ORANGE_API_CLIENT_ID=
ORANGE_API_CLIENT_SECRET=
CLIENT_USER_ID=                  # identifiant « X-Client-User-Id » (aucune valeur par défaut)
ORANGE_RELATED_RESOURCE_ID=      # identifiant de la ressource liée aux tickets
ORANGE_API_VERIFY_TLS=true       # NE PAS désactiver ; CA interne : ORANGE_API_CA_BUNDLE=/chemin/ca.pem
ORANGE_API_CA_BUNDLE=
# Limites de débit (à ajuster selon le contrat de l'API)
ORANGE_API_RATE_PER_SECOND=2
ORANGE_API_BURST=4
ORANGE_API_MAX_CONCURRENCY=2
ORANGE_API_CONNECT_TIMEOUT=5
ORANGE_API_READ_TIMEOUT=20
ORANGE_API_MAX_ATTEMPTS=8        # puis le ticket passe en « failed » + alerte interne
ORANGE_SYNC_INTERVAL_S=60        # cadence de l'outbox (création/restauration des tickets)
ORANGE_SYNC_BATCH=10
ORANGE_BREAKER_THRESHOLD=5       # échecs consécutifs avant ouverture du disjoncteur
ORANGE_BREAKER_COOLDOWN_S=300
ORANGE_API_LOOKUP_EXTERNAL_ID=false   # true si l'API sait retrouver un ticket par externalId (anti-doublon)
ORANGE_TERMINAL_STATUSES=restored,closed,cancelled,resolved

# --- E-mail
SERVER_MAIL=
SERVER_PORT=25
SMTP_TIMEOUT_S=15
SMTP_MAX_PER_MINUTE=30
SENDER_EMAIL=
SENDER_NAME=AUTODO
EMAIL_RECIPIENTS=                # "Nom,mail;Nom2,mail2" — sinon fichier email_recipients.txt (voir l'exemple)

# --- Liens vers le portail ExNet (ouverts via /go/… : les noms d'hôtes ne sont jamais envoyés au navigateur)
EXNET_TRAFFIC_LINK="https://{db_host}/exnet/diagnet/user_plane/traffic_vol.php?c={c_param}&ipset=*&protocole=1&end_date=__END_TIMESTAMP__&display=7200"
EXNET_LOSS_LINK="https://{db_host}/exnet/diagnet/user_plane/tcp_qos_internet.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200"
EXNET_TCP_SERVICE_ACCESS_LINK="https://{db_host}/exnet/diagnet/user_plane/tcp_service_access.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200&type=%"
EXNET_TCP_TTS_LINK="https://{db_host}/exnet/diagnet/user_plane/tcp_tts.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200"
EXNET_DNS_LINK="https://{db_host}/exnet/diagnet/user_plane/dns_summary.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200&type=%"
