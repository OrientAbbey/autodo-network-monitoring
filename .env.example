# ============================================================
#  AUTODO Unified Application — configuration template
#
#  Copy to .env and fill in the values:
#      cp .env.example .env
#
#  Every value below is intentionally EMPTY. Never commit a
#  filled-in .env — it holds live credentials for the monitoring
#  databases, the ExNet portal and the Orange API.
# ============================================================

# --- Monitoring databases (remote, per-site counters) ---
DB_USER=
DB_PASS=
DB_PORT=3306

# --- Dashboard / config panel auth ---
# Password required by POST /api/auth to edit alert thresholds.
CONFIG_PASSWORD=
# Session token lifetime, seconds.
TOKEN_TTL=180
APP_PORT_UNIFIED=501
APP_TICKETS_URL=http://localhost:501/tickets

# --- Local tickets database ---
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=
LOCAL_DB_PASS=
LOCAL_DB_NAME=tickets_db
LOCAL_DB_PORT=3306

# Password required by POST /api/data-management.
DATA_MANAGEMENT_PASSWORD=

# --- Outbound email (SMTP) ---
SERVER_MAIL=
SERVER_PORT=25
SENDER_EMAIL=
SENDER_NAME="AUTODO Tickets"

# --- Orange Developer CALYSPSO API (OCEANE ODI) ---
# Internal Orange network. Credentials come from the API portal;
# never reuse them outside the internal network.
ORANGE_API_CLIENT_ID=
ORANGE_API_CLIENT_SECRET=
ORANGE_API_SERVER_INTRA=
ORANGE_API_SERVER_INTER=
ORANGE_API_TOKEN_ENDPOINT=/oauth/v3/token
ORANGE_API_BASE_ENDPOINT=/troubleticket_sandbox_b2b/v3

CLIENT_USER_ID=

# --- DIAGNET ExNet portal ---
EXNET_USERNAME=
EXNET_PASSWORD=
EXNET_AUTH_SECRET=

# Diagnostic deep-links. {db_host} and {c_param} are filled from
# db_config.json; __END_TIMESTAMP__ is substituted at runtime.
EXNET_TRAFFIC_LINK="https://{db_host}/exnet/diagnet/user_plane/traffic_vol.php?c={c_param}&ipset=*&protocole=1&end_date=__END_TIMESTAMP__&display=7200"
EXNET_LOSS_LINK="https://{db_host}/exnet/diagnet/user_plane/tcp_qos_internet.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200"
EXNET_TCP_SERVICE_ACCESS_LINK="https://{db_host}/exnet/diagnet/user_plane/tcp_service_access.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200&type=%"
EXNET_TCP_TTS_LINK="https://{db_host}/exnet/diagnet/user_plane/tcp_tts.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200"
EXNET_DNS_LINK="https://{db_host}/exnet/diagnet/user_plane/dns_summary.php?c={c_param}&selected=&ipset=*&end_date=__END_TIMESTAMP__&display=7200&type=%"

# --- Internal exit databases ---
# Host values live in db_config.json (git-ignored). These *_DB_NAME
# entries only carry the schema names.
MKP_DB_NAME=DIAGNET_CAMTEL
CBC_DB_NAME=DIAGNET_CAMTEL
GAROUA_DB_NAME=DIAGNET_CAMTEL
KRIBI_DB_NAME=DIAGNET_KRIBI
OCI_DB_NAME=DIAGNET_OCI_SAT3
WACS_DB_NAME=DIAGNET_IC_WACS
WACS_BAYOBAB_DB_NAME=DIAGNET_WACS-BAYOBAB

# --- User traffic databases ---
MKPGI_DB_NAME=DIAGNET_SGi
CBCGI_DB_NAME=DIAGNET_SGi
GAROUAGI_DB_NAME=DIAGNET_SGi

# --- Roaming databases ---
ROAM_IN_GP_DB_NAME=DIAGNET_Roaming_IN_UP_Gp
ROAM_IN_S8_DB_NAME=DIAGNET_Roaming_IN_UP_S8
ROAM_OUT_DB_NAME=DIAGNET_Roaming_OUT_UP